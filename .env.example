DATABASE_URL=postgresql://qxt:qxt_dev_password@localhost:5432/qxt_funded
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
FUNDED_ACCOUNT_ENCRYPTION_KEY=replace-with-a-dedicated-stable-encryption-secret
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token-for-production
PG_POOL_MAX=10
MAX_UPLOAD_BYTES=10485760
RESET_ADMIN_PASSWORD=false
# Development-only fallback when BLOB_READ_WRITE_TOKEN is absent.
UPLOAD_DIR=./uploads
